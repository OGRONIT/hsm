# ═══════════════════════════════════════════════════════════════
# HSM — Hariii Sales Machine
# Environment Variables — Copy to .env and fill in values
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# SUPABASE
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────
# AI — CLAUDE (Anthropic)
# Get from: https://console.anthropic.com/keys
# Used for: closing conversations, objection handling
# Model: claude-sonnet-4-20250514
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─────────────────────────────────────────────────────────────
# AI — OPENAI
# Get from: https://platform.openai.com/api-keys
# Used for: initial outreach, followup messages
# Model: gpt-4o-mini
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS API (Meta Cloud API)
# Get from: https://developers.facebook.com/apps
# Or via AiSensy: https://app.aisensy.com
# Or via WATI: https://app.wati.io
# ─────────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set this to any random string — used to verify Meta's webhook calls
WHATSAPP_WEBHOOK_VERIFY_TOKEN=hsm_webhook_verify_2024

# Smit's personal WhatsApp number for receiving alerts
# Format: 91XXXXXXXXXX (with country code, no +)
SMIT_WHATSAPP_NUMBER=919876543210

# ─────────────────────────────────────────────────────────────
# TELEGRAM (for Smit's alerts)
# Create bot: https://t.me/BotFather → /newbot
# Get chat ID: send a message to the bot, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ─────────────────────────────────────────────────────────────
# CALENDLY
# Get from: https://calendly.com/integrations/api_webhooks
# ─────────────────────────────────────────────────────────────
CALENDLY_API_KEY=eyJxxxxxxxxxxxxxxxxxx
CALENDLY_BOOKING_URL=https://calendly.com/smit-hariii/20min
CALENDLY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# EMAIL — RESEND
# Get from: https://resend.com/api-keys
# Verify domain: smit@hariii.design must be verified in Resend
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# QUEUE — REDIS (Upstash for production)
# Get from: https://console.upstash.com
# Local dev: redis://localhost:6379 (Docker handles this)
# ─────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:xxxxxxxx@xxxx-xxxx.upstash.io:6379

# ─────────────────────────────────────────────────────────────
# PROXIES — BRIGHT DATA
# Get from: https://brightdata.com/cp/zones
# Zone type: Residential rotating
# ─────────────────────────────────────────────────────────────
BRIGHTDATA_USERNAME=brd-customer-xxxxxxxx-zone-residential
BRIGHTDATA_PASSWORD=xxxxxxxxxxxxxxxx
BRIGHTDATA_HOST=brd.superproxy.io

# ─────────────────────────────────────────────────────────────
# SCRAPERS — APIFY
# Get from: https://console.apify.com/account/integrations
# Used for: Instagram hashtag scraper + Facebook Groups scraper + LinkedIn
# ─────────────────────────────────────────────────────────────
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# GOOGLE MAPS PLACES API
# Get from: https://console.cloud.google.com/apis
# Enable: Places API (New)
# $200 free credit/month covers ~40k requests
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# GOOGLE CALENDAR (fallback if Calendly not used)
# Get from: https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# SCRAPER TARGETS
# Comma-separated Instagram hashtags to track (no # symbol)
# ─────────────────────────────────────────────────────────────
INSTAGRAM_HASHTAGS=manufacturer,machinery,homeappliances,industrialmachinery,madeinindia,safes,submersiblepump,gujaratmanufacturer,suratmanufacturer,ahmedabadmanufacturer

# Comma-separated Facebook Group IDs (numeric IDs from group URLs)
FACEBOOK_GROUP_IDS=123456789,987654321

# ─────────────────────────────────────────────────────────────
# ADMIN AUTH
# ADMIN_API_SECRET: any strong random string — used to auth API calls
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=smit@hariii.design
ADMIN_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# APP URLs (set after deployment)
# ─────────────────────────────────────────────────────────────
ADMIN_PANEL_URL=https://admin.hariii.design
HARIII_PORTAL_URL=https://app.hariii.design
API_URL=https://api.hariii.design

# ─────────────────────────────────────────────────────────────
# INTERNAL SERVICE AUTH
# Used for service-to-service calls (API → Queue, API → Scrapers)
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# NODE ENV
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
